{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "minimal-sorter",
  "version": "1.0.0",
  "identifier": "dev.minimal-sorter.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "File Sorter",
        "width": 480,
        "height": 600,
        "resizable": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
